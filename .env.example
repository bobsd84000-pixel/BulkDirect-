# ============================================================================
# Agent Scout Reddit - Configuration
# ============================================================================

# Reddit OAuth
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USERNAME=your_username_here
REDDIT_PASSWORD=your_password_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# LLM Fallback Chain
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
TOGETHER_API_KEY=...

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agent_scout_reddit
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis (caching & rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Company Enrichment APIs
CLEARBIT_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=

# Provider Webhooks
PROVIDER_001_WEBHOOK=https://acmecorp.example.com/leads/webhook
PROVIDER_002_WEBHOOK=https://startupboost.example.com/leads/webhook
PROVIDER_003_WEBHOOK=https://enterprise.example.com/leads/webhook

# Monitoring & Alerting
DATADOG_API_KEY=
ALERT_WEBHOOK_URL=https://your-alerts.example.com/webhook

# Environment
ENVIRONMENT=development
NODE_ENV=development
LOG_LEVEL=info

# Export (optional)
WEBHOOK_URL=https://your-webhook.com/leads
